<ov:OverlayWindow x:Class="Hermes.Overlay.ScheduleWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ov="clr-namespace:Hermes.Overlay"
                  Title="Hermes Schedule" Width="420" Height="560">
    <Grid>
        <StackPanel x:Name="Body" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12">
            <!-- Today / week toggle -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="TodayTab" Style="{StaticResource OvSmall}" Padding="0,2,4,2" Background="#01000000"
                           Cursor="Hand" ov:Hit.Interactive="True" MouseLeftButtonUp="TodayTab_Click" />
                <TextBlock Text="·" Style="{StaticResource OvSmall}" Opacity="0.4" Padding="2" />
                <TextBlock x:Name="WeekTab" Style="{StaticResource OvSmall}" Padding="4,2,0,2" Background="#01000000"
                           Cursor="Hand" ov:Hit.Interactive="True" MouseLeftButtonUp="WeekTab_Click" />
            </StackPanel>

            <TextBlock x:Name="DateLabel" Style="{StaticResource OvSmall}" Opacity="0.75" Margin="0,0,0,10" />

            <!-- Today -->
            <ItemsControl x:Name="TodayList" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ov:LessonVM}">
                        <Grid x:Name="Row" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Time" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Fg}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock x:Name="Time" Grid.Column="1" Text="{Binding Time}" Style="{StaticResource OvText}"
                                       Typography.NumeralAlignment="Tabular" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Subject" Text="{Binding Subject}" Style="{StaticResource OvText}" />
                                <TextBlock x:Name="Room" Text="{Binding Room}" Style="{StaticResource OvSmall}" Opacity="0.7"
                                           Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Past">
                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Current">
                                <Setter TargetName="Time" Property="FontSize" Value="{DynamicResource SizeCurrent}" />
                                <Setter TargetName="Subject" Property="FontSize" Value="{DynamicResource SizeCurrent}" />
                                <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Subject" Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Subject" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Dot" Property="Width" Value="9" />
                                <Setter TargetName="Dot" Property="Height" Value="9" />
                                <Setter TargetName="Room" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Breaks: a quieter line with a hollow dot, never enlarged. Placed last so it wins. -->
                            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                <Setter TargetName="Time" Property="FontSize" Value="{DynamicResource SizeSmall}" />
                                <Setter TargetName="Subject" Property="FontSize" Value="{DynamicResource SizeSmall}" />
                                <Setter TargetName="Subject" Property="FontStyle" Value="Italic" />
                                <Setter TargetName="Subject" Property="FontWeight" Value="Normal" />
                                <Setter TargetName="Time" Property="Opacity" Value="0.7" />
                                <Setter TargetName="Subject" Property="Opacity" Value="0.7" />
                                <Setter TargetName="Dot" Property="Width" Value="6" />
                                <Setter TargetName="Dot" Property="Height" Value="6" />
                                <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Fg}" />
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="1" />
                                <Setter TargetName="Room" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBreak}" Value="True" />
                                    <Condition Binding="{Binding State}" Value="Current" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Time" Property="Opacity" Value="1" />
                                <Setter TargetName="Subject" Property="Opacity" Value="1" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="NoClasses" Style="{StaticResource OvText}" Opacity="0.75" Visibility="Collapsed" />

            <!-- Compact week -->
            <ItemsControl x:Name="WeekList" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ov:WeekDayVM}">
                        <StackPanel x:Name="Day" Margin="0,0,0,9">
                            <TextBlock x:Name="Header" Text="{Binding Header}" Style="{StaticResource OvSmall}" Opacity="0.75" />
                            <TextBlock x:Name="Subjects" Text="{Binding Subjects}" Style="{StaticResource OvText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                <Setter TargetName="Day" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Header" Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Header" Property="Opacity" Value="1" />
                                <Setter TargetName="Subjects" Property="Foreground" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="UpdatedLabel" Style="{StaticResource OvSmall}" Opacity="0.45" Margin="0,12,0,0" />
        </StackPanel>

        <ov:EditChrome x:Name="Chrome" />
    </Grid>
</ov:OverlayWindow>
