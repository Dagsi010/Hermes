<Window x:Class="Hermes.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hermes.Core"
        xmlns:ui="clr-namespace:Hermes.Ui"
        ThemeMode="Dark"
        Title="{Binding [s.title], Source={x:Static core:Loc.Instance}}"
        Icon="pack://application:,,,/Assets/hermes-256.png"
        Width="580" Height="760" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SetBg}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SetCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SetCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SetText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SetHint}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,12">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,16">
                <!-- The logo is navy, so it sits on a white disc against the navy window. -->
                <Border Width="40" Height="40" CornerRadius="20" Background="White" Margin="0,0,12,0">
                    <Image Source="pack://application:,,,/Assets/hermes-256.png" Width="30" Height="30" />
                </Border>
                <TextBlock Text="Hermes" FontSize="26" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>

            <!-- General -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [s.general], Source={x:Static core:Loc.Instance}}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.startWithWindows], Source={x:Static core:Loc.Instance}}" />
                        <CheckBox x:Name="StartWithWindowsBox" Grid.Column="1" Click="StartWithWindows_Click" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.language], Source={x:Static core:Loc.Instance}}" />
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectionChanged="Language_Changed">
                            <ComboBoxItem Tag="is" Content="Íslenska" />
                            <ComboBoxItem Tag="en" Content="English" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [s.appearance], Source={x:Static core:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource Label}" Margin="0,2,0,8" Text="{Binding [s.theme], Source={x:Static core:Loc.Instance}}" />
                    <ItemsControl x:Name="ThemeList" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:ThemeSwatch}">
                                <!-- A tiny preview: the theme's background with its accent and deadline colours. -->
                                <Border Margin="0,0,8,6" CornerRadius="10" BorderThickness="2"
                                        Background="{Binding CardBrush}" BorderBrush="{Binding RingBrush}"
                                        Cursor="Hand" MouseLeftButtonUp="Theme_Click">
                                    <StackPanel>
                                        <Border Height="40" CornerRadius="8,8,0,0" Background="{Binding BackgroundBrush}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="14" Height="14" Margin="3,0" Fill="{Binding AccentBrush}" />
                                                <Ellipse Width="8" Height="8" Margin="3,0" Fill="{Binding TodayBrush}" />
                                                <Ellipse Width="8" Height="8" Margin="3,0" Fill="{Binding TomorrowBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12"
                                                   Foreground="White" Margin="0,5,0,6" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.textColor], Source={x:Static core:Loc.Instance}}" />
                        <ComboBox x:Name="TextColorBox" Grid.Column="1" SelectionChanged="TextColor_Changed">
                            <ComboBoxItem Tag="Light" Content="{Binding [s.color.light], Source={x:Static core:Loc.Instance}}" />
                            <ComboBoxItem Tag="Dark" Content="{Binding [s.color.dark], Source={x:Static core:Loc.Instance}}" />
                            <ComboBoxItem Tag="Auto" Content="{Binding [s.color.auto], Source={x:Static core:Loc.Instance}}" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.textSize], Source={x:Static core:Loc.Instance}}" />
                        <Slider x:Name="TextSizeSlider" Grid.Column="1" Minimum="0.8" Maximum="1.5" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" ValueChanged="TextSize_Changed" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.monitor], Source={x:Static core:Loc.Instance}}" />
                        <ComboBox x:Name="MonitorBox" Grid.Column="1" SelectionChanged="Monitor_Changed" />
                    </Grid>
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Click="EditLayout_Click"
                            Content="{Binding [s.editLayout], Source={x:Static core:Loc.Instance}}" />
                </StackPanel>
            </Border>

            <!-- Refresh and hotkey -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [s.refresh], Source={x:Static core:Loc.Instance}}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,16,0"
                                   Text="{Binding [s.refreshTime], Source={x:Static core:Loc.Instance}}" />
                        <ui:TimePicker x:Name="RefreshTimePicker" Grid.Column="1" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.hotkey], Source={x:Static core:Loc.Instance}}" />
                        <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 PreviewKeyDown="Hotkey_PreviewKeyDown"
                                 ToolTip="{Binding [s.hotkey.hint], Source={x:Static core:Loc.Instance}}" />
                    </Grid>
                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Foreground="#FFB4A0" Visibility="Collapsed"
                               Text="{Binding [s.hotkey.inUse], Source={x:Static core:Loc.Instance}}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.hotkeyAction], Source={x:Static core:Loc.Instance}}" />
                        <ComboBox x:Name="HotkeyActionBox" Grid.Column="1" SelectionChanged="HotkeyAction_Changed">
                            <ComboBoxItem Tag="Refresh" Content="{Binding [s.hotkey.refresh], Source={x:Static core:Loc.Instance}}" />
                            <ComboBoxItem Tag="ToggleOverlay" Content="{Binding [s.hotkey.toggle], Source={x:Static core:Loc.Instance}}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [s.notifications], Source={x:Static core:Loc.Instance}}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.reminder], Source={x:Static core:Loc.Instance}}" />
                        <CheckBox x:Name="ReminderBox" Grid.Column="1" Click="Notify_Click" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,16,0"
                                   Text="{Binding [s.reminderTime], Source={x:Static core:Loc.Instance}}" />
                        <ui:TimePicker x:Name="ReminderTimePicker" Grid.Column="1" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.newWork], Source={x:Static core:Loc.Instance}}" />
                        <CheckBox x:Name="NewWorkBox" Grid.Column="1" Click="Notify_Click" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.newGrades], Source={x:Static core:Loc.Instance}}" />
                        <CheckBox x:Name="NewGradesBox" Grid.Column="1" Click="Notify_Click" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="150" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.attendance], Source={x:Static core:Loc.Instance}}" />
                        <Slider x:Name="AttendanceSlider" Grid.Column="1" Minimum="50" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="Attendance_Changed" />
                        <TextBlock x:Name="AttendanceLabel" Grid.Column="2" Foreground="White" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Calendar -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [s.calendar], Source={x:Static core:Loc.Instance}}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.calendarSync], Source={x:Static core:Loc.Instance}}" />
                        <CheckBox x:Name="CalendarSyncBox" Grid.Column="1" Click="CalendarSync_Click" />
                    </Grid>
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Click="ExportIcs_Click"
                            Content="{Binding [s.exportIcs], Source={x:Static core:Loc.Instance}}" />
                    <TextBlock x:Name="IcsPathText" Style="{StaticResource Hint}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="{Binding [s.calendarHint], Source={x:Static core:Loc.Instance}}" />
                </StackPanel>
            </Border>

            <!-- Inna -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [s.inna], Source={x:Static core:Loc.Instance}}" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="InnaDot" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="InnaStatus" Style="{StaticResource Label}" />
                    </StackPanel>
                    <TextBlock x:Name="InnaMethod" Style="{StaticResource Hint}" Margin="19,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SignInButton" Margin="0,0,8,0" Click="SignIn_Click"
                                Content="{Binding [s.signIn], Source={x:Static core:Loc.Instance}}" />
                        <Button x:Name="SignOutButton" Margin="0,0,8,0" Click="SignOut_Click"
                                Content="{Binding [s.signOut], Source={x:Static core:Loc.Instance}}" />
                        <Button x:Name="CheckButton" Click="Check_Click"
                                Content="{Binding [s.checkNow], Source={x:Static core:Loc.Instance}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="{Binding [s.inna.privacy], Source={x:Static core:Loc.Instance}}" />
                </StackPanel>
            </Border>

            <!-- Debug: hidden until the version line is clicked five times. -->
            <Border x:Name="DebugCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [s.debug], Source={x:Static core:Loc.Instance}}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [s.debugCapture], Source={x:Static core:Loc.Instance}}" />
                        <CheckBox x:Name="DebugCaptureBox" Grid.Column="1" Click="DebugCapture_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="CaptureButton" Margin="0,0,8,0" Click="Capture_Click"
                                Style="{DynamicResource AccentButtonStyle}"
                                Content="{Binding [s.openCapture], Source={x:Static core:Loc.Instance}}" />
                        <Button Click="OpenDataFolder_Click"
                                Content="{Binding [s.openDataFolder], Source={x:Static core:Loc.Instance}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="{Binding [s.captureHint], Source={x:Static core:Loc.Instance}}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Foreground="{DynamicResource SetFaint}" FontSize="12" Margin="2,0,0,4" Background="Transparent"
                       MouseLeftButtonUp="Version_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
