<Window x:Class="Hermes.Ui.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hermes.Core"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        ThemeMode="Dark"
        Title="{Binding [si.title], Source={x:Static core:Loc.Instance}}"
        Icon="pack://application:,,,/Assets/hermes-256.png"
        Width="560" Height="780" MinWidth="420" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SetBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="20,16,20,12">
            <TextBlock Text="{Binding [si.header], Source={x:Static core:Loc.Instance}}" FontSize="20"
                       FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="{Binding [si.note], Source={x:Static core:Loc.Instance}}" Foreground="{DynamicResource SetHint}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="12,0,12,12" CornerRadius="8" ClipToBounds="True" Background="White">
            <wv2:WebView2 x:Name="Browser" />
        </Border>

        <!-- Shown once Inna has issued a token. -->
        <Border x:Name="SuccessPanel" Grid.Row="1" Margin="12,0,12,12" CornerRadius="8" Background="{DynamicResource SetCard}"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SetAccent}" HorizontalAlignment="Center">
                    <Path Data="M 0 8 L 7 15 L 20 0" Stroke="{DynamicResource SetBg}" StrokeThickness="3.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding [si.success], Source={x:Static core:Loc.Instance}}" FontSize="18" FontWeight="SemiBold"
                           Foreground="White" Margin="0,14,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Shown when Google refuses sign-in inside the embedded browser even with the Edge user agent. -->
        <Border x:Name="BlockedPanel" Grid.Row="1" Margin="12,0,12,12" CornerRadius="8" Background="{DynamicResource SetCard}"
                BorderBrush="{DynamicResource SetCardBorder}" BorderThickness="1" Padding="24" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding [si.blocked.title], Source={x:Static core:Loc.Instance}}" FontSize="18"
                           FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock Text="{Binding [si.blocked.text], Source={x:Static core:Loc.Instance}}" Foreground="{DynamicResource SetText}"
                           TextWrapping="Wrap" Margin="0,8,0,18" />
                <Button HorizontalAlignment="Stretch" Click="Island_Click" Padding="12,8"
                        Content="{Binding [si.island], Source={x:Static core:Loc.Instance}}" />
                <TextBlock Text="{Binding [si.islandNote], Source={x:Static core:Loc.Instance}}" Foreground="{DynamicResource SetHint}"
                           FontSize="12" TextWrapping="Wrap" Margin="2,4,0,14" />
                <Button HorizontalAlignment="Stretch" Click="Password_Click" Padding="12,8"
                        Content="{Binding [si.password], Source={x:Static core:Loc.Instance}}" />
                <TextBlock Text="{Binding [si.passwordNote], Source={x:Static core:Loc.Instance}}" Foreground="{DynamicResource SetHint}"
                           FontSize="12" TextWrapping="Wrap" Margin="2,4,0,14" />
                <Button HorizontalAlignment="Left" Click="RetryGoogle_Click" Padding="12,6"
                        Content="{Binding [si.retryGoogle], Source={x:Static core:Loc.Instance}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
